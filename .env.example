# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored — never commit it.

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_in_production

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=psp
RABBITMQ_PASSWORD=change_me_in_production

# ── Auth / secrets ────────────────────────────────────────────────────────────
# JWT_SECRET: minimum 32 chars of randomness (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_minimum_32_chars_long_random_string
# CTF_FLAG_SECRET: HMAC key for dynamic per-team flags — same requirement
CTF_FLAG_SECRET=change_me_minimum_32_chars_long_random_string

# ── Email (OTP verification, password reset) ─────────────────────────────────
# Required in production: application-prod.yml sets disable-verification=false,
# so registration, email verification, and forgot-password all send a 6-digit
# OTP by email. Without real credentials here, those emails silently fail to
# send (EmailStartupCheck logs a loud warning on boot if this is misconfigured)
# and accounts get stuck unverified.
#
# Gmail (the default MAIL_HOST): you MUST use an App Password, not your normal
# account password — Gmail rejects plain password auth for third-party SMTP.
# Requires 2-Step Verification enabled on the account, then generate one at:
#   https://myaccount.google.com/apppasswords
# Any other SMTP provider works too — just change MAIL_HOST.
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=

# ── CTF worker agent (optional — external service) ───────────────────────────
# The agent runs from its own compose in ../ctf-worker-agent (port 8000).
# Leave WORKER_AGENT_URL empty to disable it: the backend then spawns CTF
# instances on the local Docker daemon instead.
# From inside the backend container, the host-run agent is:
#   WORKER_AGENT_URL=http://host.docker.internal:8000
# Key id + secret come from the agent's admin dashboard (API keys page).
WORKER_AGENT_URL=
WORKER_AGENT_KEY_ID=
WORKER_AGENT_SECRET=
# URL the agent uses to download challenge ZIPs from this platform.
# Only resolves for a same-host agent — if the agent is on a SEPARATE server
# (the split-deployment case), set this to a URL that host can actually
# reach, e.g. https://platform.yourdomain.com or http://<this-host-public-ip>:8080
PLATFORM_INTERNAL_URL=http://host.docker.internal:8080

# ── Grafana (admin observability — http://localhost:3001) ────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# ── Frontend ──────────────────────────────────────────────────────────────────
# Server-side API base URL (browser clients derive the host automatically).
# Local:      http://localhost:8080
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Schema bootstrap ──────────────────────────────────────────────────────────
# The backend validates the DB schema on boot (fails fast on mismatch).
# FIRST boot on a fresh postgres volume only: uncomment the next line so
# Hibernate creates the schema, boot once, then comment it out again and
# apply backend/src/main/resources/db/migration_v*.sql going forward.
#DDL_AUTO=update
